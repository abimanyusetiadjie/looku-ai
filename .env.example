# ==========================================
# look.u AI - Environment Variables for Vercel
# ==========================================

# 1. Gemini AI API Key (Required for AI Stylist & Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Affiliate IDs for Shopee & Tokopedia Monetization
NEXT_PUBLIC_SHOPEE_AFFILIATE_ID=looku_ai
NEXT_PUBLIC_TOKOPEDIA_AFFILIATE_ID=looku_ai

# 3. Supabase Cloud Database & Auth (Optional - system has automatic graceful offline fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
